{
  "name": "pdf-comment",
  "version": "1.0.0",
  "description": "A beautiful TypeScript library for adding and displaying comments on PDF files in the browser",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
